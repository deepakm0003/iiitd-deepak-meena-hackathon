# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Secrets - never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Raw third-party data stays local (large files, and the Kaggle set includes card/PII-like columns).
data/raw/
*.zip

# Runtime state (SQLite database, logs, caches)
var/
*.db
*.sqlite
*.log

# Large intermediate files; small curated outputs are whitelisted explicitly when needed.
*.parquet

# Frontend (Part 6)
node_modules/
# frontend/dist is committed: judges run the built site without Node.js

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large trained models: rebuilt by the train-* commands or downloaded from the release (never committed)
models/event_setfit/
models/sentiment_entity/

# Other tools' local worktrees
.kilo/

models/event_head_previous.pkl

# Private handoff notes for a new Claude session (never commit)
context.md
!frontend/dist/
