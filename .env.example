# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.

# Free key from https://finnhub.io (company news). Only needed for live mode.
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email, for example:
# SEC_USER_AGENT=Tripwire research yourname@college.ac.in
SEC_USER_AGENT=
